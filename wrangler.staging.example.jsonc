{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar3d-ai-calling-staging",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "ar3d-calling-control-staging",
      "database_id": "REPLACE_WITH_STAGING_CONTROL_ID"
    },
    {
      "binding": "CRM_DB",
      "database_name": "ar3d-calling-shared-crm-staging",
      "database_id": "REPLACE_WITH_STAGING_CRM_ID"
    }
  ],
  "r2_buckets": [
    {"binding": "RECORDINGS", "bucket_name": "ar3d-calling-recordings-staging"}
  ]
}
