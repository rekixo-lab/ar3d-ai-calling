{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar3d-ai-calling",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "vars": {
    "AR3D_PLIVO_CALLER_NUMBER": "+918065491333"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "ar3d-calling-control",
      "database_id": "REPLACE_WITH_CONTROL_DATABASE_ID"
    },
    {
      "binding": "CRM_DB",
      "database_name": "ar3d-calling-shared-crm",
      "database_id": "REPLACE_WITH_SHARED_CRM_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "ar3d-calling-recordings"
    }
  ],
  "routes": [
    {
      "pattern": "aicalling.ar3dstudio.in",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "queues": {
    "producers": [
      {"binding": "WHATSAPP_TICKS", "queue": "ar3d-calling-whatsapp"}
    ],
    "consumers": [
      {"queue": "ar3d-calling-whatsapp", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 2, "max_concurrency": 1, "retry_delay": 60}
    ]
  }
}
